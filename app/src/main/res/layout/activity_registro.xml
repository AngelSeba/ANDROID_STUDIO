<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootRegistro"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shop_bg">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="195dp"
        android:layout_gravity="top"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/bg_top_waves" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:layout_gravity="bottom"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/bg_bottom_waves" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:paddingTop="40dp"
            android:paddingBottom="65dp">

            <TextView
                android:id="@+id/tvVolver"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:paddingEnd="18dp"
                android:text="‹  Volver"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/shop_brown"
                android:clickable="true"
                android:focusable="true" />

            <FrameLayout
                android:layout_width="74dp"
                android:layout_height="74dp"
                android:layout_marginTop="12dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_shop_logo"
                android:elevation="5dp">
                <ImageView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_gravity="center"
                    android:contentDescription="Bolsa de compras de SebasShop"
                    android:src="@drawable/ic_bag_white" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="¡Únete a SebasShop!"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/shop_brown" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Crea tu cuenta y comienza a explorar la tienda."
                android:textSize="15sp"
                android:textColor="@color/shop_muted" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutNombre"
                style="@style/Widget.Material3.TextInputLayout.FilledBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:hint="Nombre completo"
                app:boxBackgroundColor="@color/shop_field"
                app:boxCornerRadiusTopStart="20dp"
                app:boxCornerRadiusTopEnd="20dp"
                app:boxCornerRadiusBottomStart="20dp"
                app:boxCornerRadiusBottomEnd="20dp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:hintTextColor="@color/shop_orange"
                app:startIconDrawable="@drawable/ic_person"
                app:startIconTint="@color/shop_muted">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:autofillHints="name"
                    android:singleLine="true"
                    android:textColor="@color/shop_brown" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutCorreoRegistro"
                style="@style/Widget.Material3.TextInputLayout.FilledBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="Correo electrónico"
                app:boxBackgroundColor="@color/shop_field"
                app:boxCornerRadiusTopStart="20dp"
                app:boxCornerRadiusTopEnd="20dp"
                app:boxCornerRadiusBottomStart="20dp"
                app:boxCornerRadiusBottomEnd="20dp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:hintTextColor="@color/shop_orange"
                app:startIconDrawable="@drawable/ic_mail"
                app:startIconTint="@color/shop_muted">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCorreoRegistro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:autofillHints="emailAddress"
                    android:singleLine="true"
                    android:textColor="@color/shop_brown" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutPasswordRegistro"
                style="@style/Widget.Material3.TextInputLayout.FilledBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="Contraseña"
                app:boxBackgroundColor="@color/shop_field"
                app:boxCornerRadiusTopStart="20dp"
                app:boxCornerRadiusTopEnd="20dp"
                app:boxCornerRadiusBottomStart="20dp"
                app:boxCornerRadiusBottomEnd="20dp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:hintTextColor="@color/shop_orange"
                app:startIconDrawable="@drawable/ic_lock"
                app:startIconTint="@color/shop_muted"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/shop_muted">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPasswordRegistro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:autofillHints="newPassword"
                    android:singleLine="true"
                    android:textColor="@color/shop_brown" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutConfirmar"
                style="@style/Widget.Material3.TextInputLayout.FilledBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="Confirmar contraseña"
                app:boxBackgroundColor="@color/shop_field"
                app:boxCornerRadiusTopStart="20dp"
                app:boxCornerRadiusTopEnd="20dp"
                app:boxCornerRadiusBottomStart="20dp"
                app:boxCornerRadiusBottomEnd="20dp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:hintTextColor="@color/shop_orange"
                app:startIconDrawable="@drawable/ic_lock"
                app:startIconTint="@color/shop_muted"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/shop_muted">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:autofillHints="newPassword"
                    android:singleLine="true"
                    android:textColor="@color/shop_brown" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistrar"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="27dp"
                android:text="CREAR CUENTA"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/shop_on_orange"
                app:backgroundTint="@color/shop_orange"
                app:cornerRadius="26dp" />

            <TextView
                android:id="@+id/tvYaTengoCuenta"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="¿Ya tienes cuenta?  Inicia sesión"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/shop_orange"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
